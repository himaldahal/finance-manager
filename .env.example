# Copy to .env and adjust. Values set in the real environment win over this file.

# Required unless DEBUG=1. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Development only. Leave unset (off) in production.
DEBUG=0

# Comma separated host names the site is served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated origins (with scheme) for HTTPS sites behind a proxy, e.g. https://money.example.com
CSRF_TRUSTED_ORIGINS=

# SQLite file location (defaults to db.sqlite3 in the project root).
# DATABASE_PATH=/var/lib/finance-manager/db.sqlite3

TIME_ZONE=Asia/Kathmandu

# Default overdraft policy; each user can override it in Settings.
ALLOW_NEGATIVE_BALANCE=1
ALLOW_REGISTRATION=1
DEFAULT_CURRENCY_CODE=NPR
DEFAULT_CURRENCY_SYMBOL=Rs

# Brute force protection for the login form.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
REGISTER_MAX_PER_HOUR=10

# HTTPS hardening (defaults are on when DEBUG is off).
# SECURE_SSL_REDIRECT=1
# SECURE_HSTS_SECONDS=31536000
# Set to 1 only behind a proxy that always sets X-Forwarded-Proto.
# TRUST_X_FORWARDED_PROTO=0
